# Meet42 — variables d'environnement
# Copier en .env.local (dev) et configurer les mêmes clés sur Vercel (prod).

# URL publique du site (SEO / Open Graph). Ex: https://ton-domaine.com ou http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase (optionnel — sans NEXT_PUBLIC_SUPABASE_URL + ANON_KEY, l'app tourne en mode mock local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur uniquement (API routes) — clé service_role, ne JAMAIS exposer au client ni committer
SUPABASE_SERVICE_ROLE_KEY=

# Email de contact affiché dans l'app (footer / pages légales)
NEXT_PUBLIC_CONTACT_EMAIL=

# Portail « accès réservé » : définir un mot de passe VERROUILLE tout le site
# (domaine custom inclus). Le laisser vide/absent = site ouvert à tous.
# À mettre sur Vercel (scope Production) pendant la construction / phase testeurs.
# SITE_GATE_PASSWORD=

# ── E-mails transactionnels (Resend) ──
# Sans RESEND_API_KEY, aucun e-mail n'est envoyé (no-op propre) : réservation,
# Reveal, rappels et « Alors ton 42 ? » ne partent pas. Créer un compte gratuit
# sur resend.com → API Keys. EMAIL_FROM doit utiliser un domaine vérifié Resend
# (ou onboarding@resend.dev pour tester).
# RESEND_API_KEY=
# EMAIL_FROM=Meet42 <hello@meet42.app>

# ── Dashboard admin (/admin) ──
# Clé d'accès au dashboard concierge (membres, réservations, groupes, force-match).
# En local (mock) l'accès est ouvert. En prod, SANS cette clé le dashboard est
# verrouillé (fail-safe) ; avec, il faut la saisir sur /admin.
# ADMIN_SECRET=

# ── Crons (matching + rappels) ──
# Protège /api/cron/* en prod. Vercel Cron envoie automatiquement ce Bearer si
# la variable existe. La laisser vide = crons ouverts (OK en dev).
# CRON_SECRET=

# ── Analytics (PostHog) — optionnel ──
# Sans clé = analytics désactivée (no-op). Compte gratuit sur posthog.com.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# OAuth Facebook : "true" pour afficher le bouton (ne pas activer tant que l'app Meta / Supabase n'est pas prête)
# NEXT_PUBLIC_ENABLE_FACEBOOK_LOGIN=true

# Notes schéma Supabase :
# - Storage : bucket public « avatars » pour les photos de profil (Dashboard → Storage → New bucket → public)
# - Table « profiles » : colonne « photo_urls » de type text[] (3 à 6 photos) en plus de « photo_url » (1ʳᵉ image, pour les cartes)
